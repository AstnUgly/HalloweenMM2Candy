-- ===== AUTO-CLICK PLAY =====
local clickedButtons = {}
local lastClickTime = 0
local clicksCount = 0

local function simulateClick(btn)
    if not btn or not btn.Visible then return false end
    local pos = btn.AbsolutePosition
    local size = btn.AbsoluteSize
    if size.X < 5 or size.Y < 5 then return false end
    
    local inset = GuiService:GetGuiInset()
    local center = pos + (size / 2) + inset

    local ok = pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
        task.wait(0.1)
        vim:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
    end)
    
    if ok then
        print("[AUTO-PLAY] Clicked:", btn:GetFullName())
        return true
    end
    return false
end

local function autoClickPlay()
    if clicksCount >= 4 then return false end
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return false end
    
    for _, gui in ipairs(pg:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
            if not clickedButtons[gui] then
                local isVisible = gui.Visible
                local parent = gui.Parent
                while parent and parent ~= pg do
                    if parent:IsA("ScreenGui") and not parent.Enabled then
                        isVisible = false
                        break
                    end
                    parent = parent.Parent
                end

                if isVisible and gui.AbsoluteSize.Magnitude > 0 then
                    local text = string.lower(gui.Text or "")
                    local name = string.lower(gui.Name)
                    
                    if name == "play" or text == "play" then
                        local path = gui:GetFullName()
                        if not path:find("Archive") then
                            if simulateClick(gui) then
                                clickedButtons[gui] = true
                                lastClickTime = tick()
                                clicksCount += 1
                                return true
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

task.spawn(function()
    local idleTime = 0
    for i = 1, 30 do
        if tick() - lastClickTime < 4 then
            task.wait(1)
        else
            local clicked = autoClickPlay()
            if clicked then
                idleTime = 0
            else
                idleTime += 1
                if idleTime >= 4 then break end
            end
            task.wait(1)
        end
    end
end)

