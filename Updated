local function stopPhase()
    isTweening = false
    if currentTweenConn then
        currentTweenConn:Disconnect()
        currentTweenConn = nil
    end
    if currentStateConn then
        currentStateConn:Disconnect()
        currentStateConn = nil
    end
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CanCollide = true end
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = true
            end
        end
    end
end

local function phaseTweenTo(targetPart)
    stopPhase()
    collectedCache[targetPart] = true
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum or not targetPart then return end

    isTweening = true
    hum:ChangeState(Enum.HumanoidStateType.Physics)

    currentStateConn = hum.StateChanged:Connect(function(old, new)
        if isTweening and new ~= Enum.HumanoidStateType.Physics and new ~= Enum.HumanoidStateType.Dead then
            hum:ChangeState(Enum.HumanoidStateType.Physics)
        end
    end)

    local collected = false
    local collectWatch = targetPart:GetPropertyChangedSignal("Parent"):Connect(function()
        if not targetPart.Parent then
            collected = true
        end
    end)

    local startCFrame = hrp.CFrame
    local targetCFrame = CFrame.new(targetPart.Position) 
    local distance = (startCFrame.Position - targetCFrame.Position).Magnitude
    
    local duration = distance / SPEED_STUDS_PER_SEC
    local startTime = os.clock()

    hrp.CanCollide = false
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    local reachedTarget = false

    currentTweenConn = RunService.Heartbeat:Connect(function()
        local currentHRP = getHRP()
        if not currentHRP or reachedTarget or collected then 
            if not reachedTarget then
                reachedTarget = true
                stopPhase()
            end
            return 
        end

        local elapsed = os.clock() - startTime
        local alpha = math.clamp(elapsed / duration, 0, 1)
        
        currentHRP.CFrame = startCFrame:Lerp(targetCFrame, alpha)
        currentHRP.Velocity = Vector3.new(0, 0, 0)
        currentHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

        if alpha >= 1 then
            reachedTarget = true
            stopPhase()
        end
    end)
    
    while not reachedTarget do
        task.wait(0.01)
    end
    
    collectWatch:Disconnect()
    
    if hum then
        hum:ChangeState(Enum.HumanoidStateType.Freefall)
    end
    
    task.wait(0.2)
end

local function waitForNextRound()
    isWaitingForNextRound = true
    stopPhase()
    collectedCache = {} 
    
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then 
            hum.Health = 0 
        end
    end
    
    LocalPlayer.CharacterAdded:Wait()
    task.wait(2)
    
    isWaitingForNextRound = false
end

local function startFarmLoop()
    task.spawn(function()
        while FARM_ACTIVE do
            if isWaitingForNextRound then
                task.wait(0.5)
                continue
            end

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChild("Humanoid")
            
            if isBagFull() or (hum and hum.Health <= 0) then
                waitForNextRound()
                continue
            end

            local candy = findNearestCandy()
            if candy then
                phaseTweenTo(candy)
            else
                task.wait(0.2)
            end
        end
        stopPhase()
    end)
end

ClickBtn.MouseButton1Click:Connect(function()
    toggleUI(not FARM_ACTIVE)
    if FARM_ACTIVE then
        startFarmLoop()
    else
        stopPhase()
    end
end)

