local function fetchServerList()
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PLACE_ID)
    local ok, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if ok and res and res.data then return res.data end
    return nil
end

local function doHop(reason)
    if hopInProgress then
        status.Text = "hop already in progress"
        return
    end
    hopInProgress = true
    lastHopAttemptT = tick()
    status.Text = "hopping: " .. tostring(reason or "timer")

    local ok, err = pcall(function()
        TeleportService:Teleport(PLACE_ID, LP)
    end)

    if ok then
        task.delay(6, function()
            if hopInProgress then
                hopInProgress = false
                status.Text = "silent fail — trying PlaceInstance"
                task.spawn(function()
                    local servers = fetchServerList()
                    if servers and #servers > 0 then
                        for _, srv in ipairs(servers) do
                            if srv.id ~= game.JobId and srv.playing < srv.maxPlayers then
                                local ok2 = pcall(function()
                                    TeleportService:TeleportToPlaceInstance(PLACE_ID, srv.id, LP)
                                end)
                                if ok2 then
                                    status.Text = "queued: " .. srv.id:sub(1, 8)
                                    return
                                end
                            end
                        end
                    else
                        status.Text = "no servers found"
                    end
                    hopInProgress = false
                    lastHopT = tick() - HOP_INTERVAL + HOP_COOLDOWN
                end)
            end
        end)
    else
        status.Text = "Teleport failed: " .. tostring(err)
        hopInProgress = false
        lastHopT = tick() - HOP_INTERVAL + HOP_COOLDOWN
    end
end

pcall(function()
    TeleportService.TeleportInitFailed:Connect(function(player, resultCode, errMsg)
        if player == LP then
            print("[HOP] TeleportInitFailed:", resultCode, errMsg)
            status.Text = "init failed: " .. tostring(resultCode)
            hopInProgress = false
            lastHopT = tick() - HOP_INTERVAL + HOP_COOLDOWN
        end
    end)
end)

local function hopLoop()
    while true do
        task.wait(1)
        if hopEnabled then
            local elapsed = tick() - lastHopT
            local remaining = math.max(0, HOP_INTERVAL - elapsed)
            local mm = math.floor(remaining / 60)
            local ss = math.floor(remaining % 60)
            hopBtn.Text = string.format("Auto-Hop: %02d:%02d", mm, ss)
            if elapsed >= HOP_INTERVAL and not hopInProgress and (tick() - scriptLoadT) > HOP_SAFETY then
                doHop("timer")
            end
        else
            hopBtn.Text = "Auto-Hop: OFF"
            hopBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        end
    end
end
task.spawn(hopLoop)

hopBtn.MouseButton1Click:Connect(function()
    hopEnabled = not hopEnabled
    if hopEnabled then
        lastHopT = tick()
    end
end)

hopNowBtn.MouseButton1Click:Connect(function()
