-- ===== DISCOVERY =====
local function inLobbyObj(obj)
    local n = obj
    while n and n ~= Workspace do
        if n.Name == "Lobby" then return true end
        n = n.Parent
    end
    return false
end

local function isCoinShape(obj)
    if not obj or not obj:IsA("BasePart") then return false end
    if obj:FindFirstChildOfClass("TouchTransmitter") == nil then return false end
    local hasMeshChild = false
    for _, child in ipairs(obj:GetChildren()) do
        if child:IsA("MeshPart") or child:IsA("SpecialMesh") or child:IsA("Mesh") then
            hasMeshChild = true
            break
        end
    end
    if not hasMeshChild then return false end
    if obj.Size.Magnitude > 15 then return false end
    if inLobbyObj(obj) then return false end
    local model = obj:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then return false end
    return true
end

local function inBatchContainer(obj)
    local parent = obj.Parent
    if not parent then return false end
    local n = 0
    for _, sib in ipairs(parent:GetChildren()) do
        if sib ~= obj and isCoinShape(sib) then
            n += 1
            if n >= 2 then return true end
        end
    end
    return false
end

local function mapRootOf(obj)
    local n = obj
    while n and n.Parent and n.Parent ~= Workspace do
        n = n.Parent
    end
    return n
end

local function isIgnored(coin)
    local t = ignoredCoins[coin]
    if not t then return false end
    if tick() - t > NO_DESPAWN_SKIP then
        ignoredCoins[coin] = nil
        return false
    end
    return true
end

local function findNearest(hrp, excludeCoin)
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj ~= excludeCoin and isCoinShape(obj) and inBatchContainer(obj) and not isIgnored(obj) then
            local d = (hrp.Position - obj.Position).Magnitude
            if d < bestDist then bestDist = d; best = obj end
        end
    end
    return best, bestDist
end

