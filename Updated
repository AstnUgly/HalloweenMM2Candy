-- ===== COLLISION WIPE =====
local function wipeCollisionsOnce()
    local char = getChar()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if originalCollisions[part] == nil then
                originalCollisions[part] = part.CanCollide
            end
            if part.CanCollide then part.CanCollide = false end
            if not part.Massless then part.Massless = true end
        end
    end
end

local function restoreCollisions()
    for part, orig in pairs(originalCollisions) do
        if part and part.Parent then
            part.CanCollide = orig
            part.Massless = false
        end
    end
    originalCollisions = {}
end

-- ===== GLIDE =====
local function glideTo(candy)
    local c0, hrp0, hum0 = getChar()
    if not c0 or not hrp0 or not hum0 then return false end
    if not candy or not candy.Parent then return false end
    hrp0.Anchored = true
    hum0.WalkSpeed = 0
    hum0.JumpPower = 0

    while farming do
        if mapDirty or not roundIsLive() then hrp0.Anchored = false; return false end
        local c1, hrp1 = getChar()
        if not c1 or not hrp1 or c1 ~= c0 then return false end
        if not candy.Parent then hrp0.Anchored = false; return false end

        local dt = RunService.RenderStepped:Wait()
        if not dt or dt <= 0 then dt = MIN_DT end

        wipeCollisionsOnce()

        local c2, hrp2 = getChar()
        if not c2 or not hrp2 or c2 ~= c0 then return false end
        if not candy.Parent then hrp0.Anchored = false; return false end

        local goalPos = candy.Position
        local cur = hrp2.Position
        local delta = goalPos - cur
        local dist = delta.Magnitude
        if dist <= ARRIVE_DIST then return true end

        local speed = GLIDE_SPEED
        if dist < APPROACH_DIST then
            speed = GLIDE_SPEED * math.max(dist / APPROACH_DIST, 0.35)
        end
        local step = math.min(speed * dt, dist)
        pcall(function() hrp2.CFrame = CFrame.new(cur + delta.Unit * step) end)
    end
    return false
end

-- ===== COLLECT =====
local function collectCandyAndFindNext(candy)
    local c0, hrp, hum = getChar()
    if not c0 or not hrp or not candy or not candy.Parent then return true, nil end

    local coinPos = candy.Position
    local l, r = getLegs()
    if l and r then
        local legCenter = (l.Position + r.Position) * 0.5
        pcall(function() hrp.CFrame = CFrame.new(hrp.Position + (coinPos - legCenter)) end)
        task.wait(0.02)
        if not candy.Parent then
            local c1, hrp1 = getChar()
            if c1 and hrp1 then return true, findNearest(hrp1, candy) end
            return true, nil
        end
        local l2, r2 = getLegs()
        if l2 and r2 then
            local lc = (l2.Position + r2.Position) * 0.5
            local d = coinPos - lc
            if d.Magnitude > 0.15 then
                pcall(function() hrp.CFrame = CFrame.new(hrp.Position + d) end)
            end
        end
    else
        pcall(function() hrp.CFrame = CFrame.new(coinPos) end)
    end

    hrp.Anchored = false
    if hum then hum.WalkSpeed = 0; hum.JumpPower = 0 end

    local startT = tick()
    while farming and candy.Parent and (tick() - startT) < COLLECT_TIMEOUT do
        if mapDirty then break end
        local c1, hrp1 = getChar()
        if not c1 or not hrp1 or c1 ~= c0 then break end

        hrp1.CFrame = CFrame.new(coinPos)
        hrp1.AssemblyLinearVelocity = Vector3.zero
        hrp1.AssemblyAngularVelocity = Vector3.zero

        for _, p in ipairs(c0:GetDescendants()) do
            if p:IsA("BasePart") then
                pcall(firetouchinterest, p, candy, 0)
                pcall(firetouchinterest, p, candy, 1)
            end
        end

        status.Text = string.format("collecting (%.2fs)", tick() - startT)
        RunService.Heartbeat:Wait()
    end

    local c3, hrp3 = getChar()
    if c3 and hrp3 and c3 == c0 then hrp3.Anchored = true end

    local collected = (candy.Parent == nil)
    local nextTarget = nil
    if collected and c3 and hrp3 then
        nextTarget = findNearest(hrp3, candy)
    end
    return collected, nextTarget
end

local function step()
    if not farming then return end

    local char, hrp, hum = getChar()
    if not char then
        status.Text = charAlive and "no char" or "waiting respawn"
        task.wait(0.3)
        return
    end

    local now = tick()

    if now - lastBagCheck > BAG_CHECK_INTERVAL then
        lastBagCheck = now
        local _count, _cap, full = readBagState()
        if full then
            if resetChar() then task.wait(1.5); return end
        end
    end

    if not roundIsLive() then
        pcall(function() hrp.Anchored = false end)
        status.Text = "waiting for round"
        task.wait(0.3)
        return
    end

    local forceScan = mapDirty
    if not forceScan and now - lastRescan >= RESCAN_INTERVAL then
        lastRescan = now
        forceScan = true
    end
    if forceScan then
        mapDirty = false
        lastRescan = now
        targetPart = nil
        ignoredCoins = {}
        pcall(function() hrp.Anchored = false end)
        local nxt = findNearest(hrp, nil)
        if nxt then targetPart = nxt
        else status.Text = "no coins"; task.wait(0.2); return end
    end

    if targetPart then
        if not targetPart.Parent then targetPart = nil
        else
            local root = mapRootOf(targetPart)
            if not root or root.Parent ~= Workspace then targetPart = nil
            elseif not isCoinShape(targetPart) or not inBatchContainer(targetPart) then targetPart = nil
            elseif isIgnored(targetPart) then targetPart = nil end
        end
    end

    if not targetPart then
        pcall(function() hrp.Anchored = false end)
        local nxt = findNearest(hrp, nil)
        if nxt then targetPart = nxt
        else task.wait(0.2); return end
    end

    local candy = targetPart
    if candy and candy.Parent then
        if not glideTo(candy) then targetPart = nil; return end
        if candy.Parent then
            local ok, nextTarget = collectCandyAndFindNext(candy)
            if not ok then
                ignoredCoins[candy] = tick()
                targetPart = nil
            else
                targetPart = nextTarget
            end
            return
        else
            local c1, hrp1 = getChar()
            targetPart = (c1 and hrp1) and findNearest(hrp1, candy) or nil
            return
        end
    end
    targetPart = nil
end

local function mainLoop()
    while farming do
        local ok, err = pcall(step)
        if not ok then
            status.Text = "err: " .. tostring(err):sub(1, 80)
            task.wait(0.2)
        end
        if not charAlive then task.wait(0.2) end
    end
end

local function toggleFarm(on)
    if on ~= nil then farming = on else farming = not farming end
    btn.Text = farming and "Farm: ON" or "Farm: OFF"
    btn.BackgroundColor3 = farming and Color3.fromRGB(50, 160, 50) or Color3.fromRGB(60, 60, 60)
    if farming then
        wipeCollisionsOnce()
        targetPart = nil
        inRound = false
        roundStartAt = 0
        lastRescan = 0
        lastBagCheck = 0
        mapDirty = true
        ignoredCoins = {}
        task.spawn(mainLoop)
    else
        targetPart = nil
        local _, hrp, hum = getChar()
        if hrp then pcall(function() hrp.Anchored = false end) end
        if hum then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        restoreCollisions()
        status.Text = "idle"
    end
end

btn.MouseButton1Click:Connect(function() toggleFarm() end)

-- ===== AUTO-START =====
if AUTO_START then
    task.delay(AUTO_START_DELAY, function()
        if not farming then
            toggleFarm(true)
            status.Text = "auto-started"
        end
    end)
end
