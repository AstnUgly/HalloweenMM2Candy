local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function refreshUILabels()
    if not bagTextLabel or not bagTextLabel.Parent then
        bagTextLabel = nil
        fullLabel = nil
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            local main = pg:FindFirstChild("MainGUI")
            if main and main:FindFirstChild("Game") and main.Game:FindFirstChild("CoinBags") then
                local bags = main.Game.CoinBags
                local c = bags:FindFirstChild("Container")
                if c then
                    local candyBag = c:FindFirstChild("Candy") or c:FindFirstChild("Coin")
                    if candyBag then
                        bagTextLabel = candyBag:FindFirstChild("Coins")
                        fullLabel = candyBag:FindFirstChild("Full")
                    end
                end
            end
        end
    end
end

local function isBagFull()
    refreshUILabels()
    if fullLabel and fullLabel.Visible then return true end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, obj in ipairs(pg:GetDescendants()) do
            if (obj:IsA("TextLabel")) and obj.Visible and (obj.Text == "Full!" or obj.Text == "COIN BAG FULL!") then
                return true
            end
        end
    end
    return false
end

