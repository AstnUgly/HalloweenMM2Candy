local function setSpeed(v)
    GLIDE_SPEED = math.clamp(v, GLIDE_MIN, GLIDE_MAX)
    speedLabel.Text = string.format("Speed: %d", math.floor(GLIDE_SPEED))
    local ratio = (GLIDE_SPEED - GLIDE_MIN) / (GLIDE_MAX - GLIDE_MIN)
    sliderFill.Size = UDim2.new(ratio, 0, 1, 0)
    knob.Position = UDim2.new(ratio, -8, 0.5, -8)
end

local function sliderFromMouse(x)
    local absX = hitArea.AbsolutePosition.X
    local w = hitArea.AbsoluteSize.X
    if w <= 0 then return end
    local ratio = math.clamp((x - absX) / w, 0, 1)
    setSpeed(GLIDE_MIN + ratio * (GLIDE_MAX - GLIDE_MIN))
end

